# Twitch API — para mostrar VODs automáticamente en la sección Streaming
# Sin estas variables, la sección muestra "No hay videos recientes"
#
# Cómo obtenerlas:
# 1. Registrá una app en https://dev.twitch.tv/console/apps
#    - OAuth Redirect URL: http://localhost
#    - Categoría: Website Integration
# 2. Copiá el Client ID generado
# 3. Conseguí un App Access Token con este comando:
#    curl -X POST "https://id.twitch.tv/oauth2/token" \
#      -d "client_id=TU_CLIENT_ID" \
#      -d "client_secret=TU_CLIENT_SECRET" \
#      -d "grant_type=client_credentials"
# 4. Copiá el "access_token" de la respuesta
# 5. Renombrá este archivo a .env y completá los valores

VITE_TWITCH_CLIENT_ID=
VITE_TWITCH_ACCESS_TOKEN=
